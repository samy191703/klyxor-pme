# Configuration Keycloak OAuth2/OIDC pour KLYXOR
# ================================================

# Activer l'authentification Keycloak (true/false)
KEYCLOAK_ENABLED=true

# URL du serveur Keycloak
KEYCLOAK_AUTH_URL=https://keycloak.engie.com/auth

# Realm Keycloak (domaine d'authentification)
KEYCLOAK_REALM=ENGIE

# Client ID pour l'application KLYXOR
KEYCLOAK_CLIENT_ID=klyxor-client

# Client Secret (optionnel pour public clients)
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# URL de redirection après authentification
KEYCLOAK_REDIRECT_URI=http://localhost:5000/api/auth/keycloak/callback

# URL de redirection après déconnexion
KEYCLOAK_POST_LOGOUT_URI=http://localhost:5000

# Configuration des rôles Keycloak
# Mapper les rôles Keycloak vers les rôles KLYXOR
# Format: KEYCLOAK_ROLE_ADMIN=klyxor-admin,realm-admin
KEYCLOAK_ROLE_ADMIN=klyxor-admin
KEYCLOAK_ROLE_MANAGER=klyxor-manager
KEYCLOAK_ROLE_VALIDATOR=klyxor-validator
KEYCLOAK_ROLE_FINANCE=klyxor-finance
KEYCLOAK_ROLE_BU_MANAGER=klyxor-business-unit
KEYCLOAK_ROLE_CONTRACT_MANAGER=klyxor-contract

# Configuration de session (déjà existante)
SESSION_SECRET=your-session-secret-change-in-production

# Base de données (déjà existante)
DATABASE_URL=postgresql://user:password@host:5432/klyxor

# Environnement
NODE_ENV=development

# Domaine pour les cookies (production)
# COOKIE_DOMAIN=.engie.com

# Configuration CORS pour production
# ALLOWED_ORIGINS=https://klyxor.engie.com,https://admin.klyxor.engie.com